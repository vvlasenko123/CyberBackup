# Copy this file to .env.production.local and fill production values.
# Or generate fresh secrets without overwriting existing files: python deploy/manage.py init --environment prod

BUILD_CONFIGURATION=Release

POSTGRES_USER=cyberbackup
POSTGRES_PASSWORD=change-me-generate-a-long-password
POSTGRES_DB=cyber-backup-api
POSTGRES_AUTO_MIGRATION=true

MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-generate-a-long-password
MINIO_BUCKET_NAME=cyberbackup
MINIO_USE_SSL=false
MINIO_API_PORT=127.0.0.1:9000
MINIO_CONSOLE_PORT=127.0.0.1:9001

BACKEND_PORT=127.0.0.1:5000
FRONTEND_PORT=80

# Local verification addresses. Set real HTTPS browser origins for public deployment.
CYBER_CORS_ORIGIN=http://localhost
VITE_API_BASE_URL=http://localhost:5000

JWT_ISSUER=cyberbackup
JWT_AUDIENCE=cyberbackup-api
JWT_SIGNING_KEY=change-me-at-least-32-bytes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

REFRESH_TOKEN_LIFETIME_DAYS=7
REFRESH_TOKEN_BYTES=64

AUTH_TOKEN_CLIENT_ID=web-client
AUTH_TOKEN_SCOPE=identity

PASSWORD_HASH_PEPPER=change-me-base64-encoded-at-least-32-random-bytes
PASSWORD_HASH_WORK_FACTOR=12

SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me-generate-a-long-password
SUPERADMIN_FULL_NAME=SuperAdministrator

# Existing installation only: set BOTH exact Docker volume names after verifying backups.
# The manage.py wrapper then adds docker-compose.existing-volumes.yml automatically.
# POSTGRES_VOLUME_NAME=deploy_postgres_data
# MINIO_VOLUME_NAME=deploy_minio_data
