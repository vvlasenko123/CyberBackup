# Optional overrides for docker-compose.dev.yml. Every value falls back to a well-known local default.
# The dev server receives these from the GitHub "dev" environment (see .github/workflows/deploy-dev.yml).

# Interfaces and ports. PostgreSQL and MinIO use DEV_INTERNAL_BIND_IP, the API and frontend use DEV_BIND_IP.
# DEV_BIND_IP=0.0.0.0
# DEV_INTERNAL_BIND_IP=127.0.0.1
# DEV_BACKEND_PORT=5000
# DEV_FRONTEND_PORT=5173
# DEV_POSTGRES_PORT=5432
# DEV_MINIO_API_PORT=9000
# DEV_MINIO_CONSOLE_PORT=9001

# Browser addresses for access from another computer, with scheme and port, no trailing slash.
# DEV_API_BASE_URL=http://your-host:5000
# DEV_FRONTEND_ORIGIN=http://your-host:5173

# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=cyber-backup-api
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_BUCKET_NAME=cyberbackup
# JWT_SIGNING_KEY=
# PASSWORD_HASH_PEPPER=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_FULL_NAME=
