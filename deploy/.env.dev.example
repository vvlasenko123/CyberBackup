# Optional: copy to .env.dev.local for local overrides.
BUILD_CONFIGURATION=Debug
DEV_BIND_IP=127.0.0.1
DEV_POSTGRES_PORT=15432
DEV_BACKEND_PORT=15000
DEV_FRONTEND_PORT=5173
DEV_MINIO_API_PORT=19000
DEV_MINIO_CONSOLE_PORT=19001
# For access from another computer, set both public browser addresses:
# DEV_API_BASE_URL=http://your-development-host:15000
# DEV_FRONTEND_ORIGIN=http://your-development-host:5173
# PostgreSQL and MinIO are published on this address independently of DEV_BIND_IP.
# DEV_INTERNAL_BIND_IP=127.0.0.1

# Secrets fall back to well-known local values. The dev server receives them from
# the GitHub "dev" environment (see .github/workflows/deploy-dev.yml).
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=cyber-backup-api
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_BUCKET_NAME=cyberbackup
# JWT_SIGNING_KEY=
# PASSWORD_HASH_PEPPER=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_FULL_NAME=
